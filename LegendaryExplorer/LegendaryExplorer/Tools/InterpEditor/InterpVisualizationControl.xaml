<misc:NotifyPropertyChangedControlBase x:Class="LegendaryExplorer.Tools.InterpEditor.InterpVisualizationControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        mc:Ignorable="d"
        d:DesignHeight="400" d:DesignWidth="420">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="8,8,8,4">
            <TextBlock Text="Interp Visualization (Experimental)" FontWeight="Bold" />
            <TextBlock Text="{Binding SummaryText}" Foreground="Gray" FontSize="11" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="8,2,8,4">
            <TextBlock Text="Plane" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="70"
                      ItemsSource="{Binding PlaneOptions}"
                      SelectedItem="{Binding SelectedPlane}"
                      ToolTip="Choose the projection plane for the 2D view."
                      Margin="0,0,8,0" />

            <CheckBox Content="Paths" IsChecked="{Binding ShowPaths}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <CheckBox Content="Markers" IsChecked="{Binding ShowMarkers}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <CheckBox Content="Keys" IsChecked="{Binding ShowKeyframes}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <CheckBox Content="Labels" IsChecked="{Binding ShowKeyLabels}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <CheckBox Content="Camera" IsChecked="{Binding ShowCameraOverlays}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Show camera path emphasis and camera marker overlays when camera tracks are detected." />
            <CheckBox Content="Aim" IsChecked="{Binding ShowCameraAim}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Show current camera aim/forward vector." />
            <CheckBox Content="Frustum" IsChecked="{Binding ShowCameraFrustum}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Show 2D camera frustum wedge (uses FOV track when available)." />

            <Button Content="Fit"
                    Command="{Binding FitToViewCommand}"
                    ToolTip="Reframe the viewport to include all visible track data."
                    Padding="6,2"
                    Margin="0,0,4,0" />
            <Button Content="Reset"
                    Command="{Binding ResetViewCommand}"
                    ToolTip="Restore default options (XY, paths/markers/keys/camera overlays on, labels off) and then fit view."
                    Padding="6,2" />
        </WrapPanel>

        <Border Grid.Row="2" Margin="8,4,8,4" BorderBrush="#444" BorderThickness="1" Background="#111">
            <Grid>
                <Canvas x:Name="PreviewCanvas"
                        MinHeight="180"
                        Background="Transparent"
                        ClipToBounds="True"
                        ToolTip="Mouse wheel: zoom. Right-drag: pan."
                        PreviewMouseWheel="PreviewCanvas_OnMouseWheel"
                        MouseRightButtonDown="PreviewCanvas_OnMouseRightButtonDown"
                        MouseRightButtonUp="PreviewCanvas_OnMouseRightButtonUp"
                        MouseMove="PreviewCanvas_OnMouseMove" />

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8"
                        Padding="6,4"
                        CornerRadius="3"
                        Background="#B0101010"
                        BorderBrush="#55333333"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding OverlayTipText}" Foreground="#FFEFEFEF" FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <Slider Grid.Row="3"
                Margin="8,4,8,0"
                Minimum="0"
                Maximum="{Binding ScrubMax}"
                Value="{Binding ScrubValue, Mode=TwoWay}"
                ToolTip="Scrub interpolation time."
                TickFrequency="0.05"
                IsSnapToTickEnabled="False" />

        <TextBlock Grid.Row="4" Margin="8,4,8,8" Text="{Binding CurrentTimeText}" />
    </Grid>
</misc:NotifyPropertyChangedControlBase>
