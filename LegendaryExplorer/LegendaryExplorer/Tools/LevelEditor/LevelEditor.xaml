<misc:NotifyPropertyChangedWindowBase
        x:Class="LegendaryExplorer.Tools.LevelEditor.LevelEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        xmlns:local="clr-namespace:LegendaryExplorer.Tools.LevelEditor"
        xmlns:scene3D="clr-namespace:LegendaryExplorer.Tools.LevelEditor.Scene3D"
        xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
        xmlns:sharedUi="clr-namespace:LegendaryExplorer.SharedUI"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:sharedToolControls="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls"
        xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        xmlns:packages="clr-namespace:LegendaryExplorerCore.Packages;assembly=LegendaryExplorerCore"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        Icon="pack://application:,,,/LegendaryExplorer;component/Tools/Icons/16x16/LiveLevelEditor_Icon_16.ico"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        AllowDrop="True"
        Loaded="LevelEditor_Loaded"
        PreviewKeyDown="LevelEditor_PreviewKeyDown"
        Closing="LevelEditor_Closing"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Level Editor" Height="920" Width="1440" MinHeight="650" MinWidth="1080"
        Background="{DynamicResource EditorChrome}" Foreground="{DynamicResource EditorText}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="LevelEditorStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullEnabledConverter x:Key="NullEnabledConverter"/>
        <converters:BoolEnabledConverter x:Key="BoolEnabledConverter"/>
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <converters:ObjectStructPropertyTypeConverter x:Key="ObjectStructPropertyTypeConverter"/>
        <converters:EntryFileTypeConverter x:Key="EntryFileTypeConverter"/>
        <converters:EntryFileTypeIconPathConverter x:Key="EntryFileTypeIconPathConverter"/>
        <converters:EmbeddedFileToolTipConverter x:Key="EmbeddedFileToolTipConverter"/>
        <converters:GameTypeConverter x:Key="GameTypeConverter"/>
         <converters:GameToImageIconConverter x:Key="GameToImageIconConverter"/>
        <sharedUi:BindingProxy x:Key="bindingProxy" Data="{Binding}"/>
        <converters:UnsavedChangesForegroundConverter x:Key="UnsavedChangesForegroundConverter"/>
        <TextDecorationCollection x:Key="XTextDeco">
            <TextDecoration Location="Underline" PenOffset="2">
                <TextDecoration.Pen>
                    <Pen Brush="Red" Thickness="3"/>
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>
        <TextDecorationCollection x:Key="YTextDeco">
            <TextDecoration Location="Underline" PenOffset="2">
                <TextDecoration.Pen>
                    <Pen Brush="#00C91D" Thickness="3"/>
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>
        <TextDecorationCollection x:Key="ZTextDeco">
            <TextDecoration Location="Underline" PenOffset="2">
                <TextDecoration.Pen>
                    <Pen Brush="Blue" Thickness="3"/>
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding AddFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding ToggleSelectedActorVisibilityCommand}"/>
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding GroupSelectedActorsCommand}"/>
        <KeyBinding Key="G" Modifiers="Control+Shift" Command="{Binding UngroupActorsCommand}"/>
    </Window.InputBindings>
    <xctk:BusyIndicator IsBusy="{Binding Path=IsBusy}" BusyContent="{Binding BusyText}">
        <DockPanel Background="{StaticResource EditorChrome}">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="File" Padding="4" >
                    <MenuItem Header="Open" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" ToolTip="Open a level file (replaces current)"/>
                    <MenuItem Header="Add File..." Command="{Binding AddFileCommand}" InputGestureText="Ctrl+Shift+O" ToolTip="Add another level file to the scene"/>
                    <MenuItem Header="Load Related Levels" Command="{Binding LoadRelatedLevelsCommand}" ToolTip="Load all related level files for the current level" IsEnabled="{Binding HasAnyFileOpen}"/>
                    <MenuItem Header="Open in Interp Preview" Command="{Binding OpenInInterpPreviewCommand}" ToolTip="Open the currently loaded level set in Interp Preview" IsEnabled="{Binding HasAnyFileOpen}"/>
                    <Separator />
                    <MenuItem Header="Save All" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S" ToolTip="Save all open files in-place" IsEnabled="{Binding HasAnyFileOpen}"/>
                    <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" ToolTip="Save selected file to another location" IsEnabled="{Binding HasAnyFileOpen}"/>
                    <Separator />
                    <MenuItem Name="Recents_MenuItem" Header="Recent" IsEnabled="false"/>
                </MenuItem>
                <MenuItem Header="Visible Sets" Padding="4">
                    <MenuItem Header="Edit Visible Sets..." Command="{Binding OpenVisibleSetsManagerCommand}" IsEnabled="{Binding HasAnyFileOpen}"/>
                    <MenuItem Header="Tinted volumetric preview" IsCheckable="True" IsChecked="{Binding TintVolumetricPreview}" IsEnabled="{Binding HasAnyFileOpen}"
                              ToolTip="Unchecked: original game materials. Checked: add a faint cyan editor-only fill. Visibility is still controlled by Show Volumetric Meshes."/>
                </MenuItem>
                <MenuItem Header="Groups" Padding="4">
                    <MenuItem Header="Group Selected Actors" Command="{Binding GroupSelectedActorsCommand}" IsEnabled="{Binding CanGroupSelectedActors}" InputGestureText="Ctrl+G"/>
                    <MenuItem Header="Ungroup Actors" Command="{Binding UngroupActorsCommand}" IsEnabled="{Binding HasActiveTransformGroup}" InputGestureText="Ctrl+Shift+G"/>
                    <MenuItem Header="Reselect Group" Command="{Binding ReselectGroupCommand}" IsEnabled="{Binding CanReselectGroup}"/>
                </MenuItem>
                <MenuItem Header="Edit" Padding="4">
                    <MenuItem Header="Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                    <MenuItem Header="Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                    <Separator/>
                    <MenuItem Header="Commit Changes" Command="{Binding CommitChangesCommand}"/>
                    <MenuItem Header="Reset Uncommitted Changes..." Click="ResetUncommittedChanges_Click" IsEnabled="{Binding IsDirty}"/>
                </MenuItem>
            </Menu>
            <WrapPanel x:Name="EditorToolbar" DockPanel.Dock="Top" TextElement.FontSize="11">
                <WrapPanel Margin="4,3" VerticalAlignment="Center">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="4,2"/></Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Padding" Value="4,2"/></Style>
                    </WrapPanel.Resources>
                    <Button Content="Commit Changes" ToolTip="Commit changes made in Level Editor (does not save the file to disk!)" Command="{Binding CommitChangesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="true">
                                        <Setter Property="Background" Value="Yellow"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Name="UndoMenuItem" Click="Undo_Clicked" ToolTip="Undo (Ctrl-Z)" IsEnabled="{Binding CanUndo, Converter={StaticResource BoolEnabledConverter}, Mode=OneWay}">
                        <fa:ImageAwesome Icon="Solid_Undo" Width="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Name="RedoMenuItem" Click="Redo_Clicked" ToolTip="Redo (Ctrl-Y)" IsEnabled="{Binding CanRedo, Converter={StaticResource BoolEnabledConverter}, Mode=OneWay}">
                        <fa:ImageAwesome Icon="Solid_Redo" Width="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <RadioButton GroupName="WidgetMode" ToolTip="Translate" Command="{Binding ToggleTranslateCommand}" IsChecked="True">
                        Translate
                    </RadioButton>
                    <RadioButton GroupName="WidgetMode" ToolTip="Rotate" Command="{Binding ToggleRotateCommand}">
                        Rotate
                    </RadioButton>
                    <RadioButton GroupName="WidgetMode" ToolTip="Scale" Command="{Binding ToggleScaleCommand}">
                        Scale
                    </RadioButton>
                    <RadioButton GroupName="WidgetMode" ToolTip="Uniform Scale" Command="{Binding ToggleUniformScaleCommand}">
                        Uniform Scale
                    </RadioButton>
                    <Separator Name="SaveToggle_Separator" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <ToggleButton Content="Local Coords" ToolTip="On: move/rotate along the actor's rotated axes. Off: use the level's fixed X/Y/Z axes. Scale always uses actor axes." IsChecked="{Binding UseLocalCoordsForWidget}"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <TextBlock Text="Objects" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <ComboBox Width="120" SelectedValuePath="Tag" SelectedValue="{Binding ObjectRenderMode}" ToolTip="Control how regular scene objects are rendered">
                        <ComboBoxItem Content="Full" Tag="{x:Static local:ObjectRenderMode.Full}"/>
                        <ComboBoxItem Content="Wireframe" Tag="{x:Static local:ObjectRenderMode.Wireframe}"/>
                        <ComboBoxItem Content="Hidden" Tag="{x:Static local:ObjectRenderMode.Hidden}"/>
                        <ComboBoxItem Content="Visible Set Only" Tag="{x:Static local:ObjectRenderMode.VisibleSetOnly}"/>
                    </ComboBox>
                    <TextBlock Text="Display Filters" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <ComboBox x:Name="DisplayFilters_ComboBox" Width="165" SelectedIndex="0" SelectionChanged="DisplayFilters_ComboBox_SelectionChanged" PreviewMouseLeftButtonDown="DisplayFilters_ComboBox_PreviewMouseLeftButtonDown" ToolTip="Choose additional actor classes to display">
                        <ComboBoxItem IsEnabled="False">
                            <TextBlock Text="Select from dropdown" FontStyle="Italic" Foreground="Gray"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox Content="Show Lights"
                                      IsChecked="{Binding ShowLights}"
                                      ToolTip="Show light actors and static light collection components"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox Content="Show Collision"
                                      IsChecked="{Binding ShowCollision}"
                                      ToolTip="Show collision meshes"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox Content="Show Volumes"
                                      IsChecked="{Binding ShowVolumes}"
                                      ToolTip="Show volume wireframes"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox Content="Show Volumetric Meshes"
                                      IsChecked="{Binding ShowVolumetrics}"
                                      ToolTip="Show static and skeletal meshes identified by volumetric mesh or material names. Turn off to hide them and click objects behind them."/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox Content="Outline Selected Volumetrics"
                                      IsChecked="{Binding OutlineSelectedVolumetrics}"
                                      ToolTip="Draw selected volumetric meshes with bright cyan edges and yellow bounds, without changing their game materials."/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox Content="Show Emitters"
                                      IsChecked="{Binding ShowEmitters}"
                                      ToolTip="Show emitter actors as icon markers"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox Content="Show Location Actors"
                                      IsChecked="{Binding ShowLocationActors}"
                                      ToolTip="Show location actors (PlayerStart, BioStartLocation, Location, TargetPoint, SFXPointOfInterest)"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox Content="Show Sound Positions"
                                      IsChecked="{Binding ShowSoundPositions}"
                                      ToolTip="Show sound position actors (AmbientSound, WwiseMicPosOrient) as icon markers"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox Content="Show Cinematic Actors"
                                      IsChecked="{Binding ShowCinematicActors}"
                                      ToolTip="Show cinematic actors (BioStage wireframes, CameraActor markers, WwiseAmbientSound markers)"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <CheckBox Content="Show Decal/Effect Actors"
                                      IsChecked="{Binding ShowDecalActors}"
                                      ToolTip="Show decal/effect placement actors (DecalActor, MaterialInstanceActor) as icon markers"/>
                        </ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Light Dist" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <xctk:IntegerUpDown Value="{Binding LightRenderDistance}" Minimum="0" Maximum="1000000" Width="70"
                                        VerticalContentAlignment="Center" FormatString="N0"
                                        ToolTip="Only render lights within this many world units of the camera"/>
                     <TextBlock Text="Visible Sets Dist" VerticalAlignment="Center" Margin="8,0,4,0"/>
                     <xctk:IntegerUpDown Value="{Binding VisibleSetDistance}" Minimum="0" Maximum="1000000" Width="80"
                                         VerticalContentAlignment="Center" FormatString="N0"
                                         ToolTip="Maximum camera distance for rendering actors that are already in the visible set when Objects is set to Visible Set Only"/>
                    <Grid>
                        <CheckBox Content="Show Camera Coords"
                                  IsChecked="{Binding ShowCameraCoordinates}"
                                  ToolTip="Display the current camera world coordinates in the status bar"
                                  VerticalAlignment="Center"
                                  Padding="6,0,16,0"/>
                        <TextBlock Text="▾"
                                   FontSize="8"
                                   Width="10"
                                   Height="10"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,4,1"
                                   TextAlignment="Center"
                                   ToolTip="Camera coordinates actions"
                                   MouseLeftButtonUp="CameraCoordinatesMenuGlyph_MouseLeftButtonUp">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy Camera Coordinates"
                                              Click="CopyCameraCoordinatesMenuItem_Click"/>
                                    <MenuItem Header="Paste to Selected Actor"
                                              Click="PasteCameraCoordinatesMenuItem_Click"
                                              IsEnabled="{Binding SelectedActor, Converter={StaticResource NullEnabledConverter}}"/>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </Grid>
                    <CheckBox Content="Turbo Move"
                              IsChecked="{Binding TurboCameraMovementEnabled}"
                              ToolTip="Multiply camera movement speed for large levels"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"/>
                    <TextBlock Text="Turbo x"
                               VerticalAlignment="Center"
                               Margin="8,0,4,0"/>
                    <xctk:IntegerUpDown Value="{Binding TurboCameraMovementMultiplier}"
                                        Minimum="1"
                                        Maximum="100"
                                        Width="56"
                                        VerticalContentAlignment="Center"
                                        IsEnabled="{Binding TurboCameraMovementEnabled}"
                                        ToolTip="Turbo multiplier. Defaults to 10x."/>
                </WrapPanel>
            </WrapPanel>

            <StatusBar Height="23" DockPanel.Dock="Bottom">
                <sharedToolControls:StatusBarGameIDIndicator Visibility="{Binding HasAnyFileOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 GameType="{Binding Game}" Margin="0,-4"/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusBar_LeftMostText" Text="Select package file to load"/>
                </StatusBarItem>
                <StatusBarItem Visibility="{Binding SelectedActor, Converter={StaticResource NullVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedActor.Export.ObjectName.Instanced, StringFormat='Selected: {0}'}" Foreground="#81B3DD"/>
                </StatusBarItem>
                <StatusBarItem Visibility="{Binding HasAnyFileOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding CurrentModeName, StringFormat='Mode: {0}'}" Foreground="Gray"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding CameraCoordinatesDisplayText}" Foreground="Gray"/>
                </StatusBarItem>
            </StatusBar>
            <Grid Margin="4,0,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="210" Width="280"/>
                    <ColumnDefinition MinWidth="5" MaxWidth="5"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition MinWidth="5" MaxWidth="5"/>
                    <ColumnDefinition MinWidth="340" Width="390"/>
                </Grid.ColumnDefinitions>


                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

                <DockPanel Grid.Column="0" Background="{StaticResource EditorPanel}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource EditorDockTitle}">
                        <TextBlock Text="World Outliner" FontWeight="SemiBold"/>
                    </Border>
                    <CheckBox DockPanel.Dock="Top" Content="Group by category within each level" IsChecked="{Binding GroupActorsByCategory}" Margin="8"
                              ToolTip="Browsing categories only; this does not create or change transform groups."/>
                    <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0" Height="24">
                        <xctk:WatermarkTextBox Watermark="UIndex" Name="Goto_TextBox" Width="70" KeyUp="Goto_TextBox_KeyUp" IsEnabled="{Binding HasAnyFileOpen}"  VerticalContentAlignment="Center"/>
                        <Button Content="Goto #" Click="GotoButton_Clicked" IsEnabled="{Binding HasAnyFileOpen}" Style="{StaticResource {x:Type Button}}" Padding="7,0"/>
                    </StackPanel>
                    <xctk:WatermarkTextBox DockPanel.Dock="Top" Watermark="Search actors..." Name="ActorFilter_TextBox" Margin="5,2,5,2" Height="22"
                                           KeyUp="ActorFilter_TextBox_KeyUp" IsEnabled="{Binding HasAnyFileOpen}" VerticalContentAlignment="Center"/>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding TextBelowActors}" TextWrapping="Wrap"/>

                    <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding ActorsView}" Name="MeshExportsList" HorizontalContentAlignment="Stretch"
                             PreviewMouseLeftButtonDown="MeshExportsList_PreviewMouseLeftButtonDown"
                             MouseDoubleClick="MeshExportsList_MouseDoubleClick"
                             PreviewMouseRightButtonDown="MeshExportsList_PreviewMouseRightButtonDown"
                             SelectionChanged="MeshExportsList_SelectionChanged"
                             SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="{Binding Name.IsActorListExpanded, Mode=TwoWay, FallbackValue=True}" Margin="0,2,0,0">
                                                        <Expander.Header>
                                                            <DockPanel x:Name="FileGroupHeader" Background="{StaticResource EditorChrome}">
                                                                <Button DockPanel.Dock="Right" Content="X" Padding="4,0" Margin="2,0"
                                                                        Command="{Binding Data.CloseFileCommand, Source={StaticResource bindingProxy}}"
                                                                        CommandParameter="{Binding Name}" ToolTip="Close this file" FontSize="10"/>
                                                                <Button DockPanel.Dock="Right" Content="Save" Padding="4,0" Margin="2,0"
                                                                        Command="{Binding Data.SaveSingleFileCommand, Source={StaticResource bindingProxy}}"
                                                                        CommandParameter="{Binding Name}" ToolTip="Save this file" FontSize="10"/>
                                                                <Button DockPanel.Dock="Right" Content="Commit" Padding="4,0" Margin="2,0"
                                                                        Command="{Binding Data.CommitSingleFileCommand, Source={StaticResource bindingProxy}}"
                                                                        CommandParameter="{Binding Name}" ToolTip="Commit Level Editor changes for this file" FontSize="10"/>
                                                                <ToggleButton DockPanel.Dock="Right" Padding="2,0" Margin="2,0"
                                                                              IsChecked="{Binding Name.IsReadOnly, Mode=TwoWay}"
                                                                              ToolTip="Toggle read-only — actors cannot be edited when enabled">
                                                                    <Grid Width="12" Height="12">
                                                                        <fa:ImageAwesome Icon="Solid_Lock" Width="12"
                                                                                         Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                        <fa:ImageAwesome Icon="Solid_LockOpen" Width="12"
                                                                                         Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Not'}"/>
                                                                    </Grid>
                                                                </ToggleButton>
                                                                <TextBlock Text="{Binding Name.FileName}" FontWeight="Bold" Padding="4,2" VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                                            <Setter TargetName="FileGroupHeader" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource EditorMuted}" Margin="12,6,4,3"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type local:ActorProxy}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0" x:Name="ExportContainer">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Export.UIndex, Mode=OneTime}" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold" ToolTip="Export index"/>
                                            <TextBlock Text="{Binding DisplayText, Mode=OneTime}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="true">
                                        <Setter Property="Background" Value="Yellow" TargetName="ExportContainer"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                            <ContextMenu x:Key="MyMenu">
                                <MenuItem Header="Focus Camera" Command="{Binding Data.FocusSelectedCommand, Source={StaticResource bindingProxy}}" InputGestureText="F"/>
                                <MenuItem Header="Open in Package Editor" Command="{Binding Data.OpenInPackageEditorCommand, Source={StaticResource bindingProxy}}"/>
                                <Separator/>
                                <MenuItem Header="Show Only This Actor" Command="{Binding Data.ShowOnlySelectedCommand, Source={StaticResource bindingProxy}}"/>
                                <MenuItem Header="Add This Actor to Visible Set" Command="{Binding Data.AddSelectedToVisibleSetCommand, Source={StaticResource bindingProxy}}" InputGestureText="Ctrl+V (Toggle)" ToolTip="Adds selected actor to the visible set. Ctrl+V toggles add/remove based on current state."/>
                                <MenuItem Header="Remove This Actor from Visible Set" Command="{Binding Data.RemoveSelectedFromVisibleSetCommand, Source={StaticResource bindingProxy}}" InputGestureText="Ctrl+V (Toggle)" ToolTip="Removes selected actor from the visible set. Ctrl+V toggles add/remove based on current state."/>
                                <Separator/>
                                <MenuItem Header="Show Only This Class" Command="{Binding Data.ShowOnlySelectedClassCommand, Source={StaticResource bindingProxy}}"/>
                                <MenuItem Header="Add This Class to Visible Set" Command="{Binding Data.AddSelectedClassToVisibleSetCommand, Source={StaticResource bindingProxy}}"/>
                                <MenuItem Header="Remove This Class from Visible Set" Command="{Binding Data.RemoveSelectedClassFromVisibleSetCommand, Source={StaticResource bindingProxy}}"/>
                                <Separator/>
                                <MenuItem Header="Clear All Sets" Command="{Binding Data.ClearVisibleSetCommand, Source={StaticResource bindingProxy}}"/>
                                <MenuItem Header="Show All" Command="{Binding Data.ShowAllMeshesCommand, Source={StaticResource bindingProxy}}"/>
                                <Separator/>
                                <MenuItem Header="Group Selected Actors" Command="{Binding Data.GroupSelectedActorsCommand, Source={StaticResource bindingProxy}}" IsEnabled="{Binding Data.CanGroupSelectedActors, Source={StaticResource bindingProxy}}" InputGestureText="Ctrl+G"/>
                                <MenuItem Header="Ungroup Actors" Command="{Binding Data.UngroupActorsCommand, Source={StaticResource bindingProxy}}" IsEnabled="{Binding Data.HasActiveTransformGroup, Source={StaticResource bindingProxy}}" InputGestureText="Ctrl+Shift+G"/>
                            </ContextMenu>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="ContextMenu" Value="{StaticResource MyMenu}"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </DockPanel>

                <DockPanel Grid.Column="2" Background="{StaticResource EditorPanel}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource EditorDockTitle}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Focus Selected" Command="{Binding FocusSelectedCommand}" Padding="7,3"/>
                            <TextBlock Text="Viewport" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <WrapPanel x:Name="ViewportOptions" DockPanel.Dock="Top" Margin="6">
                        <CheckBox Content="Game Shaders" IsChecked="{Binding UseGameShaders}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="125" SelectedValuePath="Tag" SelectedValue="{Binding LightingMode}" ToolTip="Lighting is independent of object visibility.">
                            <ComboBoxItem Content="Level lighting" Tag="{x:Static scene3D:ViewportLightingMode.Level}"/>
                            <ComboBoxItem Content="Preview lighting" Tag="{x:Static scene3D:ViewportLightingMode.Preview}"/>
                            <ComboBoxItem Content="Unlit" Tag="{x:Static scene3D:ViewportLightingMode.Unlit}"/>
                        </ComboBox>
                        <CheckBox Content="Dynamic Lights" IsChecked="{Binding UseDynamicLighting}" VerticalAlignment="Center" Margin="8,0"
                                  ToolTip="Controls real-time illumination, not marker display. Baked contributions remain in lightmaps."/>
                        <CheckBox Content="Lightmaps" IsChecked="{Binding UseLightMaps}" VerticalAlignment="Center"
                                  ToolTip="Show baked texture and vertex lighting."/>
                        <CheckBox x:Name="TopDownToggle" Content="Top Down" Margin="8,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Toggle top-down orthographic view (Numpad 5)" IsChecked="{Binding IsOrthographicView}"/>
                    </WrapPanel>
                    <scene3D:SceneRenderControl x:Name="SceneViewer"/>
                </DockPanel>


                <DockPanel Grid.Column="4" Background="{StaticResource EditorPanel}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource EditorDockTitle}">
                        <TextBlock Text="Details" FontWeight="SemiBold"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <GroupBox DockPanel.Dock="Top" Header="Transform Group" Margin="5,0,5,5" BorderThickness="2" Padding="5"
                              IsEnabled="{Binding HasAnyFileOpen}">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveTransformGroupSummary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Bottom" Header="Snap" Margin="5,5,5,0" BorderThickness="2" Padding="5"
                              DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Translate -->
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="Translate" VerticalAlignment="Center"
                                      IsChecked="{Binding TranslateSnapEnabled}" Margin="0,2,0,2"/>
                            <xctk:SingleUpDown Grid.Row="0" Grid.Column="1" Value="{Binding TranslateSnapValue}"
                                               Minimum="0.001" FormatString="F1" ButtonSpinnerLocation="Left"
                                               ToolTip="Snap step in world units" Margin="5,2,0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="units" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <!-- Rotation -->
                            <CheckBox Grid.Row="1" Grid.Column="0" Content="Rotation" VerticalAlignment="Center"
                                      IsChecked="{Binding RotateSnapEnabled}" Margin="0,2,0,2"/>
                            <xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RotateSnapValue}"
                                               Minimum="0.1" Maximum="180" FormatString="F1" ButtonSpinnerLocation="Left"
                                               ToolTip="Snap step in degrees" Margin="5,2,0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="°" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <!-- Scale -->
                            <CheckBox Grid.Row="2" Grid.Column="0" Content="Scale" VerticalAlignment="Center"
                                      IsChecked="{Binding ScaleSnapEnabled}" Margin="0,2,0,2"/>
                            <xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ScaleSnapValue}"
                                               Minimum="0.01" FormatString="F1" ButtonSpinnerLocation="Left"
                                               ToolTip="Snap step as percent (10 = 0.1 per step)" Margin="5,2,0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                    </GroupBox>
                    <StackPanel x:Name="wrapPanel" IsEnabled="{Binding ., Converter={StaticResource NullEnabledConverter}}" DataContext="{Binding SelectedActor}">
                    <GroupBox Header="Actor Position" Margin="5,0,5,5" BorderThickness="2" Padding="5">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="X:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}"/>
                                    <xctk:SingleUpDown Name="xPosUpDown" Value="{Binding XPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="3,0,3,0">
                                    <TextBlock Text="Y:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}"/>
                                    <xctk:SingleUpDown Name="yPosUpDown" Value="{Binding YPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Z:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}"/>
                                    <xctk:SingleUpDown Name="zPosUpDown" Value="{Binding ZPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0, 5, 0, 0" Orientation="Horizontal">
                                <TextBlock Text=" Increment:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" Minimum="0" ButtonSpinnerLocation="Left" FormatString="F3"/>
                            </StackPanel>
                            <WrapPanel Margin="0, 5, 0, 0">
                                <Button Content="Copy Location Coords" Click="CopyLocationCoordinatesButton_Click"/>
                                <Button Content="Paste Location Coords" Click="PasteLocationCoordinatesButton_Click" Margin="10,0,0,0"/>
                            </WrapPanel>

                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Actor Rotation" Margin="5,0,5,5" BorderThickness="2">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=" Roll:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}" />
                                <xctk:SingleUpDown Name="rollUpDown" Value="{Binding RollDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left"/>
                                <TextBlock Text=" Pitch:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}" />
                                <xctk:SingleUpDown Name="pitchUpDown" Value="{Binding PitchDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left"/>
                                <TextBlock Text=" Yaw:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}" />
                                <xctk:SingleUpDown Name="yawUpDown" Value="{Binding YawDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left"/>
                            </StackPanel>
                            <StackPanel Margin="0, 5, 0, 0" Orientation="Horizontal">
                                <TextBlock Text=" Increment:  " VerticalAlignment="Center" />
                                <xctk:IntegerUpDown Value="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" Minimum="0" ButtonSpinnerLocation="Left"/>
                            </StackPanel>
                            <WrapPanel Margin="0, 5, 0, 0">
                                <Button Content="Copy Rotation Coords" Click="CopyRotationCoordinatesButton_Click"/>
                                <Button Content="Paste Rotation Coords" Click="PasteRotationCoordinatesButton_Click" Margin="10,0,0,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Actor DrawScale" Margin="5,0,5,5" BorderThickness="2" >
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" Scale:  " VerticalAlignment="Center" />
                                    <xctk:SingleUpDown Name="scaleUpDown" Value="{Binding DrawScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"  ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" X:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}" />
                                    <xctk:SingleUpDown Name="xScaleUpDown" Value="{Binding XScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"  ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" Y:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}" />
                                    <xctk:SingleUpDown Name="yScaleUpDown" Value="{Binding YScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"  ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" Z:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}" />
                                    <xctk:SingleUpDown Name="zScaleUpDown" Value="{Binding ZScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0, 5, 0, 0" Orientation="Horizontal">
                                <TextBlock Text=" Increment:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" Minimum="0" ButtonSpinnerLocation="Left" FormatString="F3"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Light" Margin="5,0,5,5" BorderThickness="2"
                              Visibility="{Binding SupportsLightProperties, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text=" Brightness:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding LightBrightness}" Minimum="0" ButtonSpinnerLocation="Left" FormatString="F3" Width="90"/>
                                <TextBlock Text=" Radius:  " VerticalAlignment="Center" Margin="8,0,0,0" />
                                <xctk:SingleUpDown Value="{Binding LightRadius}" Minimum="0" ButtonSpinnerLocation="Left" FormatString="F1" Width="90"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text=" Source Radius:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding LightSourceRadius}" Minimum="0" ButtonSpinnerLocation="Left" FormatString="F1" Width="90"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text=" Colour:  " VerticalAlignment="Center" />
                                <xctk:ColorPicker SelectedColor="{Binding LightColor}" Width="160" Height="24"
                                                  DisplayColorAndName="True"/>
                            </StackPanel>
                            <TextBlock Text=" Lighting Channels:" Margin="0,2,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Static" IsChecked="{Binding LightChannelStatic}" Margin="0,0,8,0"/>
                                <CheckBox Content="Dynamic" IsChecked="{Binding LightChannelDynamic}" Margin="0,0,8,0"/>
                                <CheckBox Content="CompositeDynamic" IsChecked="{Binding LightChannelCompositeDynamic}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="BioStage Overlay" Margin="5,0,5,5" BorderThickness="2"
                              Visibility="{Binding IsBioStageActorSelected, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}, Converter={StaticResource BoolToVisibilityConverter}}"
                              DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}">
                        <StackPanel Orientation="Vertical">
                            <CheckBox Content="Show Stage Nodes"
                                      IsChecked="{Binding ShowStageNodes}"
                                      ToolTip="Show node markers from the selected BioStage skeletal mesh reference skeleton"/>
                            <CheckBox Content="Show Stage Cameras"
                                      IsChecked="{Binding ShowStageCameras}"
                                      ToolTip="Show camera markers from the selected BioStage skeletal mesh reference skeleton"/>

                            <Border Margin="0,6,0,0" Padding="6,4" Background="#33FFD966" BorderBrush="#99C9A100" BorderThickness="1" CornerRadius="2">
                                <TextBlock Text="Warning: Marker edits apply to the shared stage parent asset (all instances)."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#FF5C4700"/>
                            </Border>

                            <Expander Header="Markers" IsExpanded="{Binding IsBioStageMarkersExpanded}" Margin="0,6,0,0"
                                      Visibility="{Binding HasBioStageMarkers, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                                    <ListBox ItemsSource="{Binding BioStageMarkers}"
                                             SelectedItem="{Binding SelectedBioStageMarker, Mode=TwoWay}"
                                             DisplayMemberPath="DisplayLabel"
                                             MinHeight="70"
                                             MaxHeight="140"/>

                                    <StackPanel Margin="0,6,0,0"
                                                Visibility="{Binding HasSelectedBioStageMarker, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Selected Marker Transform" FontWeight="SemiBold" Margin="0,0,0,3"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="X:" Width="20" VerticalAlignment="Center"/>
                                            <xctk:SingleUpDown Value="{Binding SelectedBioStageMarker.XPos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                                               ButtonSpinnerLocation="Left" FormatString="F3" Width="95"/>
                                            <TextBlock Text="Y:" Width="20" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <xctk:SingleUpDown Value="{Binding SelectedBioStageMarker.YPos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                                               ButtonSpinnerLocation="Left" FormatString="F3" Width="95"/>
                                            <TextBlock Text="Z:" Width="20" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <xctk:SingleUpDown Value="{Binding SelectedBioStageMarker.ZPos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                                               ButtonSpinnerLocation="Left" FormatString="F3" Width="95"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Pitch:" Width="38" VerticalAlignment="Center"/>
                                            <xctk:SingleUpDown Value="{Binding SelectedBioStageMarker.PitchDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                                               ButtonSpinnerLocation="Left" FormatString="F3" Width="95"/>
                                            <TextBlock Text="Yaw:" Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <xctk:SingleUpDown Value="{Binding SelectedBioStageMarker.YawDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                                               ButtonSpinnerLocation="Left" FormatString="F3" Width="95"/>
                                            <TextBlock Text="Roll:" Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <xctk:SingleUpDown Value="{Binding SelectedBioStageMarker.RollDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                                               ButtonSpinnerLocation="Left" FormatString="F3" Width="95"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <Border x:Name="WelcomePanel" Grid.Column="0" Grid.ColumnSpan="5" Visibility="{Binding HasAnyFileOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Not'}"
                        Background="{StaticResource EditorPanel}" Padding="24">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel MaxWidth="720" HorizontalAlignment="Center">
                    <TextBlock Margin="0,0,0,12" Text="Welcome to Level Editor" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}">
                This is a work in progress, and only displays some of the actors in a level.
                If you have issues with Level Editor, please report them to one of the following places:
                <LineBreak/>
            - <Hyperlink NavigateUri="{Binding Path=(misc:AppLinks.ME3TweaksDiscordInviteURL), Mode=OneTime}" Foreground="#81B3DD" misc:HyperlinkExtensions.IsExternal="True">
                <Run Text="The ME3Tweaks Discord (#Legendary_Explorer channel)"/>
            </Hyperlink>                                <LineBreak/>
                 - The issues list on GitHub at
                <Hyperlink NavigateUri="{Binding Path=(misc:AppLinks.BugReportURL), Mode=OneTime}" Foreground="#81B3DD" misc:HyperlinkExtensions.IsExternal="True">
                    <Run Text="{Binding Path=(misc:AppLinks.BugReportURL), Mode=OneTime}"/>
                </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="Recent level sets" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10"
                               Visibility="{Binding RecentSets.Count, Converter={StaticResource NullVisibilityConverter}}"/>
                    <ItemsControl ItemsSource="{Binding RecentSets}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="320" Margin="0,0,8,8" Padding="8" ToolTip="{Binding TooltipText}"
                                        Command="{Binding DataContext.OpenRecentSetCommand, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding Game, Converter={StaticResource GameToImageIconConverter}}" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </xctk:BusyIndicator>
</misc:NotifyPropertyChangedWindowBase>
