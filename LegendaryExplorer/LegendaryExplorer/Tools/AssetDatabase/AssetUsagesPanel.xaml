<UserControl x:Class="LegendaryExplorer.Tools.AssetDatabase.AssetUsagesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.com/icons/"
             xmlns:assetDatabase="clr-namespace:LegendaryExplorer.Tools.AssetDatabase"
             xmlns:controls="clr-namespace:LegendaryExplorer.SharedUI.Controls"
             x:Name="usagesPanel">
    <UserControl.Resources>
        <assetDatabase:FileIndexToNameConverter x:Key="FileIndexToNameConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock Text="{Binding HeaderText, ElementName=usagesPanel}" Background="AliceBlue" HorizontalAlignment="Stretch" Padding="3"
                       ToolTip="{Binding HeaderToolTip, ElementName=usagesPanel}"/>
            <Button ToolTip="Copies the list of usages to the clipboard as text" Click="CopyButton_Click"
                    VerticalAlignment="Center" Padding="3" HorizontalAlignment="Right" Width="26">
                <fa:ImageAwesome Icon="Solid_Copy" Foreground="CornflowerBlue"/>
            </Button>
        </Grid>
        <DockPanel Grid.Row="1" Margin="2,2,2,3" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                <CheckBox x:Name="importsFilterCheckBox" Content="Imports" IsChecked="True" Checked="UsageFilterChanged" Unchecked="UsageFilterChanged" Margin="0,0,6,0"/>
                <CheckBox x:Name="exportsFilterCheckBox" Content="Exports" IsChecked="True" Checked="UsageFilterChanged" Unchecked="UsageFilterChanged"/>
            </StackPanel>
            <TextBox x:Name="fileNameFilterTextBox" VerticalAlignment="Center" TextChanged="UsageFilterChanged" ToolTip="Filter filenames. Supports wildcards like *Biod_Nor*"/>
        </DockPanel>
        <controls:ListBoxScroll x:Name="internalListBox" MinWidth="200"
                                Grid.Row="2">
            <controls:ListBoxScroll.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource FileIndexToNameConverter}">
                                <Binding Path="FileKey"/>
                                <Binding Path="FileListExtended" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}"/>
                                <Binding Path="UIndex"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DataTemplate>
            </controls:ListBoxScroll.ItemTemplate>
            <controls:ListBoxScroll.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsInDLC}" Value="True">
                            <Setter Property="Background" Value="LightGray"/>
                            <Setter Property="TextElement.ToolTip" Value="DLC content"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsInMod}" Value="True">
                            <Setter Property="Foreground" Value="IndianRed"/>
                            <Setter Property="TextElement.ToolTip" Value="Mod - file from a mod DLC directory"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:ListBoxScroll.ItemContainerStyle>
        </controls:ListBoxScroll>
    </Grid>
</UserControl>
